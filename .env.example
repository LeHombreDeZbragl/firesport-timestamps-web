# ─── Server ───────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Supabase (server-side only) ───────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Admin write access ────────────────────────────────────
# Set a strong random password to enable the admin login flow.
# Generate one with: openssl rand -hex 32
# Leave unset to run the server in read-only mode.
ADMIN_SECRET=

# ─── JWT signing secret ────────────────────────────────────
# Used to sign and verify admin session tokens (8-hour expiry).
# Must be set whenever ADMIN_SECRET is set.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# ─── CORS origin (optional) ───────────────────────────────
# Override the allowed cross-origin request origin.
# Defaults to false (same-origin only) in production and
# http://localhost:5173 in development.
# Only needed if you serve the frontend from a different domain.
# CORS_ORIGIN=https://your-custom-domain.com