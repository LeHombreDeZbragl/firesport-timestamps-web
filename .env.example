# ─── Server ───────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Supabase (server-side only) ───────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Admin write access ────────────────────────────────────
# Set a strong random secret to enable write routes locally.
# Generate one with: openssl rand -hex 32
# Leave unset in production — the server is read-only by default.
ADMIN_SECRET=

# ─── Client admin UI (client/.env.local) ──────────────────
# Create client/.env.local (gitignored) and set this to the
# SAME value as ADMIN_SECRET above.  Vite injects it at build
# time; the prod Docker build runs without this file so the
# admin UI is never present in the deployed bundle.
#
# client/.env.local:
#   VITE_ADMIN_SECRET=<same value as ADMIN_SECRET>